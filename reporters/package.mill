  object test extends SbtTests with KamonScalaTest {
    def moduleDeps = super.moduleDeps ++ Seq(core.testkit(crossValue))

    def mvnDeps = Seq(
      Deps.scalatest,
      Deps.logbackClassic
    )
  }
