package build.instrumentation

import mill.*, scalalib.*, publish.*, build.*
import mill.javalib.JavaModule
import mill.javalib.Dep
import mill.contrib.scalapblib.ScalaPBModule

/** Base path for modules with custom test source paths */
val InstrumentationRoot: os.Path = os.pwd / "instrumentation"

trait GrpcTests extends ScalaPBModule { self: KamonModule#CrossSbtTests =>
  def grpcCodegenDep: Dep
  def grpcCodegenName: String
  def grpcCodegenMainClass: String

  def scalaPBVersion = Deps.scalaPbCodegenVersion
  override def scalaPBFlatPackage = true
  override def scalaPBGrpc = false
  override def scalaPBProtocPath = Task { Some(scalaPBResolveProtoc().path.toString) }
  override def scalaPBSources = Task.Sources("src/test/protobuf")

  def grpcCodegenLauncher: T[PathRef] = Task {
    val classpath = defaultResolver().classpath(Seq(grpcCodegenDep)).map(_.path).mkString(java.io.File.pathSeparator)
    val launcher = Task.dest / s"protoc-gen-$grpcCodegenName"
    os.write(
      launcher,
      s"#!/bin/sh\nexec java -cp '$classpath' $grpcCodegenMainClass \"$$@\"\n"
    )
    os.perms.set(launcher, os.PermSet.fromString("rwxr-xr-x"))
    PathRef(launcher)
  }

  def compileGrpcServices: T[PathRef] = Task {
    val sourceRoot = scalaPBSources().head.path
    val protoFiles = os.walk(sourceRoot).filter(path => os.isFile(path) && path.ext == "proto")
    val output = Task.dest
    os.makeDir.all(output)
    os.proc(
      scalaPBResolveProtoc().path,
      s"--plugin=protoc-gen-$grpcCodegenName=${grpcCodegenLauncher().path}",
      s"--${grpcCodegenName}_out=language=scala,flat_package,generate_client=true,generate_server=true:$output",
      s"--proto_path=$sourceRoot",
      protoFiles
    ).call()
    PathRef(output)
  }

  override def generatedSources: T[Seq[PathRef]] = Task {
    super.generatedSources() :+ compileGrpcServices()
  }
}

/** Java-only annotation API module - no Scala dependency */
object annotationApi extends annotationApi
trait annotationApi extends JavaModule with SonatypeCentralPublishModule {

  override def artifactName = "kamon-annotation-api"

  def publishVersion: T[String] = kamonVersion

  def pomSettings = PomSettings(
    description = "Kamon Annotation API",
    organization = "io.kamon",
    url = "https://kamon.io",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("kamon-io", "Kamon"),
    developers = Seq(
      Developer("Ivan", "Topolnjak", "https://github.com/ivantopo"),
      Developer("Diego", "Parra", "https://github.com/dpsoft")
    )
  )

  def javacOptions = CommonJavacOptions ++ Seq("-Xdoclint:none")
  override def javadocOptions = Seq("-Xdoclint:none")
}

object annotation extends Cross[annotation](AllScalaVersions)
trait annotation extends KamonModule {

  override def artifactName = "kamon-annotation"

  def moduleDeps = Seq(core.core(crossValue), annotationApi)

  def compileMvnDeps = Seq(
    Deps.kanelaAgent
  )

  // Dependencies to shade
  def shadedMvnDeps = Seq(
    Deps.caffeine,
    Deps.glassfishEl
  )

  // Make shaded deps available at compile time
  override def mandatoryMvnDeps = super.mandatoryMvnDeps() ++ shadedMvnDeps

  // Shading rules
  override def shadingRules = super.shadingRules ++ Seq(
    Assembly.Rule.Relocate("javax.el.**", "kamon.lib.@1"),
    Assembly.Rule.Relocate("com.sun.el.**", "kamon.lib.@1"),
    Assembly.Rule.Relocate("com.github.benmanes.**", "kamon.lib.@1"),
    Assembly.Rule.Relocate("com.google.errorprone.**", "kamon.lib.@1"),
    Assembly.Rule.Relocate("org.checkerframework.**", "kamon.lib.@1"),
    Assembly.Rule.ExcludePattern("META-INF/maven.*")
  )

  // Use shaded JAR as the published artifact
  override def jar: T[PathRef] = jarWithShadedDependencies

  object test extends TestWithKanelaAgent {
    def moduleDeps = super.moduleDeps ++ Seq(core.testkit(crossValue))

    def mvnDeps = Seq(
      Deps.scalatest,
      Deps.logbackClassic
    )
  }
}

