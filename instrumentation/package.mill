object executors extends Cross[executors](AllScalaVersions) {
  val ExperimentalTestClass = "kamon.instrumentation.executor.CaptureContextOnSubmitInstrumentationSpec"
}
trait executors extends KamonModule {

  override def artifactName = "kamon-executors"

  def moduleDeps = Seq(core.core(crossValue), common(crossValue))

  def compileMvnDeps = Seq(
    Deps.kanelaAgent
  )

  object test extends TestWithKanelaAgent {
    def moduleDeps = super.moduleDeps ++ Seq(core.testkit(crossValue))

    def mvnDeps = Seq(
      Deps.scalatest,
      Deps.logbackClassic,
      Deps.guava
    )

    override def discoveredTestClasses: T[Seq[String]] = Task {
      super.discoveredTestClasses().filterNot(_ == executors.ExperimentalTestClass)
    }
  }

  object experimental extends Module {
    object test extends TestWithKanelaAgent {
      def moduleDeps = super.moduleDeps ++ Seq(core.testkit(crossValue))

      def mvnDeps = Seq(
        Deps.scalatest,
        Deps.logbackClassic,
        Deps.guava
      )

      override def forkArgs: T[Seq[String]] = Task {
        super.forkArgs() ++ Seq(
          "-Dkanela.modules.executor-service.enabled=false",
          "-Dkanela.modules.executor-service-capture-on-submit.enabled=true"
        )
      }

      override def discoveredTestClasses: T[Seq[String]] = Task {
        super.discoveredTestClasses().filter(_ == executors.ExperimentalTestClass)
      }
    }
  }
}

