/** Play Framework versions for cross-compilation */
val PlayVersions = Seq("play28", "play29", "play30")

/** Scala 2.13 only for Play modules (Play 2.8/2.9 don't support Scala 3) */
val Scala213Only = Seq(build.Scala2Version)

/** Base path for play module sources */
val PlayModulePath: os.Path = InstrumentationRoot / "play"

object play extends Cross[play](Scala213Only)
trait play extends KamonModule {

  override def artifactName = "kamon-play"

  // Play depends on common (for HTTP instrumentation), akkaHttp and pekkoHttp (for ServerFlowWrapper)
  def moduleDeps = Seq(core.core(crossValue), common(crossValue), akkaHttp(crossValue), pekkoHttp(crossValue))

  // Play 2.8 dependencies are provided at compile time for main sources
  def compileMvnDeps = Seq(
    Deps.kanelaAgent,
    Deps.play28,
    Deps.play28NettyServer,
    Deps.play28AkkaHttpServer,
    Deps.play28AkkaHttp2Support,
    Deps.play28Ws,
    Deps.play28Test,
    Deps.play28Logback,
    Deps.scalatestPlusPlay28
  )

  /** Test module with Play version dimension */
  object test extends Cross[PlayTestModule](PlayVersions)
  trait PlayTestModule extends TestWithKanelaAgent with Cross.Module[String] {
    def playVersion: String = crossValue

    def moduleDeps = super.moduleDeps ++ Seq(core.testkit(play.this.crossValue))

    // All Play versions use the same test sources from the parent module
    override def sources: T[Seq[PathRef]] = Task.Sources(
      PlayModulePath / "src" / "test" / "scala"
    )

    override def resources: T[Seq[PathRef]] = Task.Sources(
      PlayModulePath / "src" / "test" / "resources"
    )

    // Extra JVM args for Play 2.8 (Java module exports)
    override def forkArgs: T[Seq[String]] = Task {
      val baseArgs = super.forkArgs()
      playVersion match {
        case "play28" => baseArgs ++ Seq(
          "--add-exports=java.base/sun.security.x509=ALL-UNNAMED",
          "--add-opens=java.base/sun.security.ssl=ALL-UNNAMED"
        )
        case _ => baseArgs
      }
    }

    def mvnDeps = {
      val baseDeps = Seq(Deps.scalatest)

      playVersion match {
        case "play28" => baseDeps ++ Seq(
          Deps.play28,
          Deps.play28NettyServer,
          Deps.play28AkkaHttpServer,
          Deps.play28AkkaHttp2Support,
          Deps.play28Ws,
          Deps.play28Test,
          Deps.play28Logback,
          Deps.scalatestPlusPlay28,
          Deps.guice,
          Deps.guiceAssistedInject
        )
        case "play29" => baseDeps ++ Seq(
          Deps.play29,
          Deps.play29NettyServer,
          Deps.play29AkkaHttpServer,
          Deps.play29AkkaHttp2Support,
          Deps.play29Ws,
          Deps.play29Test,
          Deps.play29Logback,
          Deps.scalatestPlusPlay29
        )
        case "play30" => baseDeps ++ Seq(
          Deps.play30,
          Deps.play30NettyServer,
          Deps.play30PekkoHttpServer,
          Deps.play30PekkoHttp2Support,
          Deps.play30Ws,
          Deps.play30Test,
          Deps.play30Logback,
          Deps.scalatestPlusPlay30
        )
      }
    }
  }
}

/** Cassandra driver versions for cross-compilation */
val CassandraDriverVersions = Seq("cas3", "cas4")

/** Base path for cassandra module sources */
val CassandraModulePath: os.Path = InstrumentationRoot / "cassandra"

object cassandra extends Cross[cassandra](AllScalaVersions)
trait cassandra extends KamonModule {

  override def artifactName = "kamon-cassandra"

  def moduleDeps = Seq(core.core(crossValue), executors(crossValue))

  // Both driver versions are provided at compile time since main code works with both
  def compileMvnDeps = Seq(
    Deps.kanelaAgent,
    Deps.cassandra3xDriver,
    Deps.cassandra4xDriverCore,
    Deps.cassandra4xQueryBuilder
  )

  /** Test module with additional Cassandra driver version dimension */
  object test extends Cross[CassandraTestModule](CassandraDriverVersions)
  trait CassandraTestModule extends TestWithKanelaAgent with Cross.Module[String] {
    def cassandraDriverVersion: String = crossValue

    def moduleDeps = super.moduleDeps ++ Seq(core.testkit(cassandra.this.crossValue))

    def testSourceDir: String = cassandraDriverVersion match {
      case "cas3" => "testCas3"
      case "cas4" => "testCas4"
    }

    // Override sources to point to the driver-specific test directory
    override def sources: T[Seq[PathRef]] = Task.Sources(
      CassandraModulePath / "src" / testSourceDir / "scala"
    )

    override def resources: T[Seq[PathRef]] = Task.Sources(
      CassandraModulePath / "src" / testSourceDir / "resources"
    )

    def mvnDeps = {
      val baseDeps = Seq(
        Deps.scalatest,
        Deps.logbackClassic,
        Deps.testContainersCassandra
      )

      cassandraDriverVersion match {
        case "cas3" => baseDeps :+ Deps.cassandra3xDriver
        case "cas4" => baseDeps ++ Seq(Deps.cassandra4xDriverCore, Deps.cassandra4xQueryBuilder)
      }
    }
  }
}
