import mill.javalib.Dep

def Scala2Version = "2.13.13"
def Scala3Version = "3.3.7"
def AllScalaVersions = Seq(Scala2Version, Scala3Version)

def kamonVersion: T[String] = GitVersionModule.version()()

def collectPublishModules(mod: Module): Seq[PublishModule] = {
  val self = mod match {
    case p: PublishModule => Seq(p)
    case _ => Seq.empty
  }
  self ++ mod.moduleDirectChildren.flatMap(collectPublishModules)
}

def publishedModules: Seq[PublishModule] = {
  val roots = Seq(this.core, this.bundle, this.reporters, this.instrumentation)
  roots.flatMap(collectPublishModules)
}

object bom extends BomModule with SonatypeCentralPublishModule {
  override def artifactName = "kamon-bom"

  def publishVersion: T[String] = kamonVersion

  def pomSettings = PomSettings(
    description = "Kamon Bill of Materials (BOM)",
    organization = "io.kamon",
    url = "https://kamon.io",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("kamon-io", "Kamon"),
    developers = Seq(
      Developer("Ivan", "Topolnjak", "https://github.com/ivantopo"),
      Developer("Diego", "Parra", "https://github.com/dpsoft")
    )
  )

  override def publishXmlDepMgmt: Task[Seq[mill.javalib.publish.Dependency]] = Task.Anon {
    val artifacts = Task.traverse(publishedModules)(_.artifactMetadata)()
    artifacts.sortBy(_.id).map { artifact =>
      mill.javalib.publish.Dependency(artifact.copy(version = "${project.version}"), mill.javalib.publish.Scope.Compile)
    }
  }

  override def pom: T[PathRef] = Task {
    val basePom = super.pom()
    val content = os.read(basePom.path)
    val cleaned = content.replaceAll(" *<dependencies> *</dependencies>\n?", "")
    val pomPath = Task.dest / s"${artifactId()}-${publishVersion()}.pom"
    os.write.over(pomPath, cleaned)
    PathRef(pomPath)
  }
}

